# OpenAI API 配置（通过 OneAPI 网关统一接入）
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://your-oneapi-endpoint.com/v1
OPENAI_MODEL=minimax-m2.7

# 模型温度（DeepSeek R1 / kimi 只支持 1，其他模型 0~2）
OPENAI_TEMPERATURE=0.7

# Embedding 配置（RAG 向量化，默认使用阿里云 DashScope）
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v1

# PostgreSQL 配置（Docker 中自动覆盖为 postgres 服务名）
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ragdb
PG_USER=
PG_PASSWORD=

# Redis 配置（Docker 中自动覆盖为 redis 服务名）
REDIS_URL=redis://localhost:6379

# 服务端口
PORT=3500

# LangSmith 可观测性配置
# 注册地址：https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-agent-learn
